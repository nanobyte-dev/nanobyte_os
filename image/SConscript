import os
import re
import struct
import subprocess
import time
from decimal import Decimal
from io import SEEK_CUR, SEEK_SET
from pathlib import Path
from shutil import copy2

from SCons.Action import Action
from SCons.Builder import Builder
from SCons.Environment import Environment

from build_scripts.utility import FindIndex, GlobRecursive, IsFileName

Import('mbr')
Import('stage1')
Import('stage2')
Import('kernel')

Import('TARGET_ENVIRONMENT')
TARGET_ENVIRONMENT: Environment
env:Environment = TARGET_ENVIRONMENT

SECTOR_SIZE = 512

def run(*command, env=None):
    """
    Runs a command and returns its output. If it fails, stops the build and shows the output.
    """
    command = [str(arg) for arg in command]
    result = subprocess.run(command, env=env, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    if result.returncode != 0:
        raise RuntimeError(f"'{' '.join(command)}' failed with exit code {result.returncode}:\n{result.stdout}")
    return result.stdout


def generate_image_file(target: str, size_sectors: int):
    with open(target, 'wb') as fout:
        fout.write(bytes(size_sectors * SECTOR_SIZE))
        fout.close()

def create_filesystem(target: str, filesystem, reserved_sectors=0, offset=0):
    if filesystem in ['fat12', 'fat16', 'fat32']:
        reserved_sectors += 1
        if filesystem == 'fat32':
            reserved_sectors += 1

        run('mkfs.fat',
            '-F', filesystem[3:],           # fat size
            '-n', 'NBOS',                   # label
            '-R', reserved_sectors,         # reserved sectors
            f'--offset={offset}',
            target)
    elif filesystem == 'ext2':
        run('mkfs.ext2',
            '-L', 'NBOS',                   # label
            '-E', f'offset={offset * SECTOR_SIZE}',
            target)
    else:
        raise ValueError('Unsupported filesystem ' + filesystem)


def find_symbol_in_map_file(map_file: str, symbol: str):
    with map_file.open('r') as fmap:
        for line in fmap:
            if symbol in line:
                match = re.search('0x([0-9a-fA-F]+)', line)
                if match is not None:
                    return int(match.group(1), base=16)
    return None


def install_mbr(target: str, mbr: str):
    """
    Writes the MBR boot code into the first sector, in front of the partition table.
    """
    with open(mbr, 'rb') as fmbr:
        code = fmbr.read()

    # the disk signature (offset 440) and partition table (offset 446) come after the code
    if len(code) > 440:
        raise ValueError(f"MBR code is {len(code)} bytes, only 440 fit in front of the partition table")

    with os.fdopen(os.open(target, os.O_WRONLY | os.O_CREAT), 'wb+') as ftarget:
        ftarget.seek(0, SEEK_SET)
        # pad with zeros, so nothing from a previous MBR is left behind
        ftarget.write(code.ljust(440, b'\0'))


def install_stage1(target: str, stage1: str, stage2_offset, stage2_size, offset=0):
    # find stage1 map file
    map_file = Path(stage1).with_suffix('.map')
    if not map_file.exists():
        raise ValueError("Can't find " + map_file)
    
    entry_offset = find_symbol_in_map_file(map_file, '__entry_start')
    if entry_offset is None:
        raise ValueError("Can't find __entry_start symbol in map file " + str(map_file))
    entry_offset -= 0x7c00

    stage2_start = find_symbol_in_map_file(map_file, 'stage2_location')
    if stage2_start is None:
        raise ValueError("Can't find stage2_location symbol in map file " + str(map_file))
    stage2_start -= 0x7c00

    with open(stage1, 'rb') as fstage1:
        with os.fdopen(os.open(target, os.O_WRONLY | os.O_CREAT), 'wb+') as ftarget:
            ftarget.seek(offset * SECTOR_SIZE, SEEK_SET)

            # write first 3 bytes jump instruction
            ftarget.write(fstage1.read(3))

            # write starting at entry_offset (end of header)
            fstage1.seek(entry_offset - 3, SEEK_CUR)
            ftarget.seek(entry_offset - 3, SEEK_CUR)
            ftarget.write(fstage1.read())

            # write location of stage2
            ftarget.seek(offset * SECTOR_SIZE + stage2_start, SEEK_SET)
            ftarget.write(stage2_offset.to_bytes(4, byteorder='little'))
            ftarget.write(stage2_size.to_bytes(1, byteorder='little'))

def install_stage2(target: str, stage2: str, offset=0, limit=None):
    with open(stage2, 'rb') as fstage2:
        with os.fdopen(os.open(target, os.O_WRONLY | os.O_CREAT), 'wb+') as ftarget:
            ftarget.seek(offset * SECTOR_SIZE, SEEK_SET)
            ftarget.write(fstage2.read())

def image_files(kernel, files, env):
    """
    What goes into the file system: the kernel in /boot, and everything under image/root.
    Returns (path in the image, source path or None for a directory) pairs, parents first.
    """
    entries = [('boot', None), ('boot/' + os.path.basename(kernel), kernel)]
    src_root = env['BASEDIR']
    for file in files:
        file_src = file.srcnode().path
        file_rel = os.path.relpath(file_src, src_root)
        entries.append((file_rel, None if os.path.isdir(file_src) else file_src))
    return entries


def copy_files_mtools(image: str, entries, offset=0):
    """Copies files into a FAT partition with mtools, without mounting it."""
    # mtools addresses a partition inside a disk image as image@@<byte offset>
    target = image if offset == 0 else f'{image}@@{offset * SECTOR_SIZE}'
    # skip mtools' sanity check on the disk geometry, which an image file doesn't have
    mtools_env = dict(os.environ, MTOOLS_SKIP_CHECK='1')
    for path, src in entries:
        if src is None:
            print('    ... creating directory', path)
            run('mmd', '-i', target, '::' + path, env=mtools_env)
        else:
            print('    ... copying', path)
            run('mcopy', '-i', target, src, '::' + path, env=mtools_env)


def copy_files_to_dir(root: str, entries):
    for path, src in entries:
        dst = os.path.join(root, path)
        if src is None:
            print('    ... creating directory', path)
            os.makedirs(dst, exist_ok=True)
        else:
            print('    ... copying', path)
            copy2(src, dst)


def build_floppy(image, stage1, stage2, kernel, files, env):
    size_sectors = 2880
    stage2_size = os.stat(stage2).st_size
    stage2_sectors = (stage2_size + SECTOR_SIZE - 1) // SECTOR_SIZE
    
    generate_image_file(image, size_sectors)

    print(f"> formatting file using fat12...")
    create_filesystem(image, 'fat12', stage2_sectors)

    print(f"> installing stage1...")
    install_stage1(image, stage1, stage2_offset=1, stage2_size=stage2_sectors)

    print(f"> installing stage2...")
    install_stage2(image, stage2, offset=1)

    print(f"> copying files...")
    copy_files_mtools(image, image_files(kernel, files, env))


# MBR partition type for each file system
PARTITION_TYPES = {
    'fat12': 0x01,
    'fat16': 0x0E,      # FAT16, LBA addressing
    'fat32': 0x0C,      # FAT32, LBA addressing
    'ext2':  0x83,      # Linux
}

def lba_to_chs(lba: int, total_sectors: int):
    """
    Converts a sector number to the 3 byte CHS address used in partition entries.

    The geometry is the one most BIOSes come up with for LBA disks ("LBA-assist" translation):
    63 sectors per track, and the fewest heads (16, 32, 64, 128 or 255) that keep the disk
    within 1024 cylinders.

    A disk image has no geometry of its own, so BIOSes also look at the partition table: the
    partition's end address gives the number of heads and sectors per track. For that to work,
    addresses after the last whole cylinder (or past cylinder 1023) are replaced with the last
    sector of the last whole cylinder. Those sectors can only be reached with LBA.
    """
    sectors = 63
    heads = 16
    while heads < 255 and total_sectors > 1024 * heads * sectors:
        heads = min(heads * 2, 255)

    last_cylinder = min(1023, total_sectors // (heads * sectors) - 1)
    cylinder = lba // (heads * sectors)
    if cylinder > last_cylinder:
        cylinder, head, sector = last_cylinder, heads - 1, sectors
    else:
        head = (lba // sectors) % heads
        sector = lba % sectors + 1      # sectors start at 1

    # byte 1: sector in bits 0-5, bits 8-9 of the cylinder in bits 6-7; byte 2: bits 0-7 of the cylinder
    return bytes([head, sector | ((cylinder >> 2) & 0xC0), cylinder & 0xFF])


def create_partition_table(target: str, start: int, filesystem: str):
    """
    Writes an MBR partition table with a single active partition, from `start` to the end of the disk.
    """
    total_sectors = os.path.getsize(target) // SECTOR_SIZE
    if total_sectors <= start:
        raise ValueError(f"imageSize is too small, the partition starts at {start * SECTOR_SIZE // 1024} KiB")
    end = total_sectors - 1

    entry = struct.pack('<B3sB3sII',
                        0x80,                           # active (bootable)
                        lba_to_chs(start, total_sectors),
                        PARTITION_TYPES[filesystem],
                        lba_to_chs(end, total_sectors),
                        start,                          # first sector (LBA)
                        end - start + 1)                # size in sectors

    with os.fdopen(os.open(target, os.O_WRONLY), 'wb') as ftarget:
        ftarget.seek(440, SEEK_SET)
        ftarget.write(os.urandom(4))                   # disk signature, which some operating systems use to tell disks apart
        ftarget.write(bytes(2))
        ftarget.write(entry)                            # partition table: 4 entries, the other 3 stay empty
        ftarget.seek(510, SEEK_SET)
        ftarget.write(b'\x55\xAA')                      # boot signature


def mount_fs(image: str, mount_dir: str, mount_method: str):
    if mount_method == 'guestfs':
        run('guestmount', '--add', image, '--mount', '/dev/sda1', mount_dir)
        return None
    elif mount_method == 'mount':
        # sudo asks for your password itself, on the terminal, if it needs it
        loop_device = run('sudo', 'losetup', '--find', '--show', '--partscan', image).strip()
        run('sudo', 'mount', '-o', f'uid={os.getuid()},sync', loop_device + 'p1', mount_dir)
        return loop_device
    else:
        raise ValueError("Unknown mount method - " + mount_method)


def unmount_fs(mount_dir: str, mount_method, mount_token):
    time.sleep(2)
    if mount_method == 'guestfs':
        run('fusermount', '-u', mount_dir)
    else:
        run('sudo', 'umount', mount_dir)
        run('sudo', 'losetup', '--detach', mount_token)
        time.sleep(1)


def build_disk(image, mbr, stage1, stage2, kernel, files, env):
    size_sectors = (env['imageSize'] + SECTOR_SIZE - 1) // SECTOR_SIZE
    file_system = env['imageFS']
    mount_method = env['mountMethod']
    partition_offset = 2048

    stage1_size = os.stat(stage1).st_size
    stage2_size = os.stat(stage2).st_size
    stage2_sectors = (stage2_size + SECTOR_SIZE - 1) // SECTOR_SIZE

    generate_image_file(image, size_sectors)

    # create partition table
    print(f"> creating partition table...")
    create_partition_table(image, partition_offset, file_system)

    print(f"> installing MBR...")
    install_mbr(image, mbr)

    if mount_method == 'mtools' and file_system not in ['fat12', 'fat16', 'fat32']:
        raise ValueError(f"mountMethod 'mtools' only supports FAT; use 'guestfs' or 'mount' for {file_system}")

    entries = image_files(kernel, files, env)

    # create file system
    print(f"> formatting file using {file_system}...")
    create_filesystem(image, file_system, offset=partition_offset)

    # install stage1
    print(f"> installing stage1...")
    install_stage1(image, stage1, offset=partition_offset, stage2_offset=1, stage2_size=stage2_sectors)
 
    # install stage2
    print(f"> installing stage2...")
    install_stage2(image, stage2, offset=1, limit=partition_offset)

    if mount_method == 'mtools':
        print(f"> copying files...")
        copy_files_mtools(image, entries, offset=partition_offset)
        return

    tempdir_name = 'tmp_mount_{0}'.format(int(time.time()))
    tempdir = os.path.join('/tmp', tempdir_name)
    mounted = False
    mount_token = None
    try:
        # mount
        os.mkdir(tempdir)

        print(f"> mounting image to {tempdir}...")
        mount_token = mount_fs(image, tempdir, mount_method)
        mounted = True

        print(f"> copying files...")
        copy_files_to_dir(tempdir, entries)

    finally:
        print("> cleaning up...")
        # only unmount if mounting worked, otherwise the real error gets buried under retries
        for tries in range(5 if mounted else 0):
            try:
                unmount_fs(tempdir, mount_method, mount_token)
                break
            except BaseException as ex:
                print('    ... attempt', tries, 'to unmount failed:', ex)
                time.sleep(5)
        if os.path.isdir(tempdir):
            os.rmdir(tempdir)


def build_image(target, source, env):
    mbr = str(source[0])
    stage1 = str(source[1])
    stage2 = str(source[2])
    kernel = str(source[3])
    files = source[4:]

    image = str(target[0])
    if env['imageType'] == 'floppy':
        build_floppy(image, stage1, stage2, kernel, files, env)
    elif env['imageType'] == 'disk':
        build_disk(image, mbr, stage1, stage2, kernel, files, env)
    else:
        raise ValueError('Unknown image type ' + env['imageType'])


# Setup image target
root = env.Dir('root')
root_content = GlobRecursive(env, '*', root)
inputs = [mbr, stage1, stage2, kernel] + root_content

output_fmt = 'img'
# if env['imageType'] == 'qcow3':
#     output_fmt = 'qcow3'

output = f'image.{output_fmt}'

# varlist: also rebuild when the image options change, not just the input files
image = env.Command(output, inputs,
                    action=Action(build_image, 'Creating disk image...',
                                  varlist=['imageType', 'imageFS', 'imageSize', 'mountMethod']),
                    BASEDIR=root.srcnode().path)
env.Depends(image, inputs)

# build_image's own code is tracked, but not the code of the functions it calls, so rebuild the
# image whenever this script changes
env.Depends(image, env.File('SConscript').srcnode())

Export('image')